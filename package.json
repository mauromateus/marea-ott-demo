{
  "name": "marea-ott-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Marea: PWA / thin-shell proof of concept for an OTT, built on the ott-next-core-web stack",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:pages": "cross-env PUBLIC_URL=/marea-ott-demo react-scripts build && node scripts/prepare-pages.js",
    "test": "react-scripts test --testPathPattern=src/tests/",
    "serve:build": "npx serve -s build",
    "icons": "node scripts/generate-icons.js",
    "sync:media": "node scripts/sync-media.js",
    "preview:pages": "node scripts/preview-pages.js",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "jotai": "2.16.1",
    "prop-types": "15.6.1",
    "qrcode": "^1.5.4",
    "react": "16.12.0",
    "react-dom": "16.12.0",
    "react-helmet": "5.2.1",
    "react-router-dom": "5.2.0",
    "react-scripts": "5.0.1",
    "styled-components": "5.2.3",
    "swiper": "^6.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "pngjs": "^7.0.0",
    "workbox-core": "^6.5.4",
    "workbox-expiration": "^6.5.4",
    "workbox-precaching": "^6.5.4",
    "workbox-routing": "^6.5.4",
    "workbox-strategies": "^6.5.4"
  }
}
